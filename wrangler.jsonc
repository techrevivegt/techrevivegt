// Configuración de Cloudflare Workers para TechRevive.
// - Publica la carpeta _site (el sitio que genera build.py).
// - worker/index.js atiende el panel de administración (/panel y /api).
{
  "name": "techrevive",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/aula", "/aula/*", "/descargas/*"]
  },
  "r2_buckets": [
    {
      "binding": "AULAOS_RELEASES",
      "bucket_name": "techrevive-aulaos"
    }
  ],
  "vars": {
    // Tu repositorio de GitHub (usuario/repositorio) y la rama.
    "GITHUB_REPO": "techrevivegt/techrevivegt",
    "GITHUB_BRANCH": "main"
  }
  // La base de datos (estadísticas, certificados y progreso del aula) NO se
  // escribe aquí: build.py la agrega sola al publicar si pegaste su ID en
  // Panel → Configuración general → «ID de la base de datos».
  // Los secretos PANEL_PASSWORD y GITHUB_TOKEN se agregan en Cloudflare:
  // tu Worker → Settings → Variables and Secrets → Add → tipo "Secret".
}
